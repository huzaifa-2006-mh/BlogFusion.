generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  image     String?
  posts     Post[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String
  excerpt     String
  coverImage  String?
  images      String[] // Support for multiple images
  category    Category @relation(fields: [categoryId], references: [id])
  categoryId  String
  author          User     @relation(fields: [authorId], references: [id])
  authorId        String
  published       Boolean  @default(false)
  showOnHome      Boolean  @default(true)
  shortDescription String? // Dedicated field for title subtext
  faqs            Json?    // Stores Question/Answer pairs
  views           Int      @default(0)
  metaTitle       String?
  metaDescription String?
  focusKeywords   String?
  ogImage         String? // Advanced SEO
  canonicalUrl    String? // Advanced SEO
  isIndexable     Boolean  @default(true) // Advanced SEO
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PageSeo {
  id              String   @id @default(cuid())
  pagePath        String   @unique // e.g., "/", "/about", "/contact"
  metaTitle       String?
  metaDescription String?
  focusKeywords   String?
  ogImage         String?
  canonicalUrl    String?
  isIndexable     Boolean  @default(true)
  updatedAt       DateTime @updatedAt
}


model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  posts       Post[]
  showOnHome  Boolean  @default(true)
  description String?
}

model Analytics {
  id          String   @id @default(cuid())
  visitorId   String   // Browser-based unique ID
  email       String?  // Optional email if provided
  path        String?
  duration    Int      @default(0) // total seconds
  lastPing    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
